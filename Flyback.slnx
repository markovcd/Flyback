<Solution>
  <!--
    Debug and Release are enough of a list that .slnx would otherwise infer
    them and stop there; naming All plugins here is what puts it in an IDE's
    own configuration picker (Directory.Build.props does the same for a
    project's Configurations property, which is a different list).
  -->
  <Configurations>
    <Platform Name="Any CPU" />
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="All plugins" />
  </Configurations>
  <Folder Name="/docs/">
    <File Path="CHANGELOG.md" />
    <File Path="CONTRIBUTING.md" />
    <File Path="docs/engineering-guide.md" />
    <File Path="docs/glossary.md" />
    <File Path="docs/language.md" />
    <File Path="README.md" />
    <File Path="TODO.md" />
    <Project Path="docs/adr/ADR.csproj">
      <Build Project="false" />
    </Project>
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/Flyback.Editor.Desktop/Flyback.Editor.Desktop.csproj" />
    <Project Path="src/Flyback.Assist/Flyback.Assist.csproj" />
    <Project Path="src/Flyback.Editor/Flyback.Editor.csproj" />
    <Project Path="src/Flyback.Cli/Flyback.Cli.csproj" />
    <Project Path="src/Flyback.Core/Flyback.Core.csproj" />
    <Project Path="src/Flyback.Engine/Flyback.Engine.csproj" />
    <Project Path="src/Flyback.Gpu/Flyback.Gpu.csproj" />
    <Project Path="src/Flyback.Plugins/Flyback.Plugins.csproj" />
    <Project Path="src/Flyback.Ui/Flyback.Ui.csproj" />
    <Project Path="src/Flyback.Viewer.Desktop/Flyback.Viewer.Desktop.csproj" />
    <Project Path="src/Flyback.Server/Flyback.Server.csproj" />
    <Project Path="src/Flyback.Viewer.Web/Flyback.Viewer.Web.csproj" />
    <Project Path="src/Flyback.Editor.Web/Flyback.Editor.Web.csproj" />
  </Folder>
  <Folder Name="/src/plugins/">
    <Project Path="src/plugins/Flyback.Plugins.Dpapi/Flyback.Plugins.Dpapi.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.Easy/Flyback.Plugins.Easy.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.Effects/Flyback.Plugins.Effects.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.Figures/Flyback.Plugins.Figures.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.Fractals/Flyback.Plugins.Fractals.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.Gemini/Flyback.Plugins.Gemini.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.Keychain/Flyback.Plugins.Keychain.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.Keyring/Flyback.Plugins.Keyring.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.LinuxIO/Flyback.Plugins.LinuxIO.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.MacIO/Flyback.Plugins.MacIO.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.Mastering/Flyback.Plugins.Mastering.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.OpenAi/Flyback.Plugins.OpenAi.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.ClaudeCode/Flyback.Plugins.ClaudeCode.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.Picture/Flyback.Plugins.Picture.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.Voice/Flyback.Plugins.Voice.csproj" />
    <Project Path="src/plugins/Flyback.Plugins.WinIO/Flyback.Plugins.WinIO.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Flyback.Ui.Testing/Flyback.Ui.Testing.csproj" />
    <Project Path="tests/Flyback.Editor.Tests/Flyback.Editor.Tests.csproj" />
    <Project Path="tests/Flyback.Ui.Tests/Flyback.Ui.Tests.csproj" />
    <Project Path="tests/Flyback.Viewer.Desktop.Tests/Flyback.Viewer.Desktop.Tests.csproj" />
    <Project Path="tests/Flyback.Editor.Desktop.Tests/Flyback.Editor.Desktop.Tests.csproj" />
    <Project Path="tests/Flyback.Cli.Tests/Flyback.Cli.Tests.csproj" />
    <Project Path="tests/Flyback.Core.Benchmarks/Flyback.Core.Benchmarks.csproj" />
    <Project Path="tests/Flyback.Specs/Flyback.Specs.csproj" />
    <Project Path="tests/Flyback.Core.Tests/Flyback.Core.Tests.csproj" />
    <Project Path="tests/Flyback.Plugins.FakeAssistant/Flyback.Plugins.FakeAssistant.csproj" />
    <Project Path="tests/Flyback.Plugins.Gemini.Tests/Flyback.Plugins.Gemini.Tests.csproj" />
    <Project Path="tests/Flyback.Plugins.OpenAi.Tests/Flyback.Plugins.OpenAi.Tests.csproj" />
    <Project Path="tests/Flyback.Plugins.ClaudeCode.Tests/Flyback.Plugins.ClaudeCode.Tests.csproj" />
    <Project Path="tests/Flyback.Plugins.Sample/Flyback.Plugins.Sample.csproj" />
