# The build context is copied whole, so what is not here ends up in the image.
# Build output is the part that matters: an obj/ from the host carries absolute
# paths and a restore of its own, and the container would try to build against
# both.
**/bin/
**/obj/
artifacts/
dist/
coverage/

# The Worker's packages are restored inside the build, and what wrangler made is not source.
**/node_modules/
worker/.wrangler/
worker/public/
worker/large/

.git/
.github/
.idea/
.vs/
.vscode/
.claude/

Dockerfile
.dockerignore

*.user
*.suo
*.received.*
*.dmp
*.nettrace
.DS_Store
