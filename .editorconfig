root = true

[*.cs]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
# A case block's braces sit at the case's own indent.
csharp_indent_case_contents_when_block = false
# Every namespace is file-scoped.
csharp_style_namespace_declarations = file_scoped:warning

# A builder returning Control, or a parser rule returning Statement, is the abstraction on purpose, and none of it is hot.
dotnet_diagnostic.CA1859.severity = none
# Step, Stop and Resume are the words for them; the plugin surface is C# only.
dotnet_diagnostic.CA1716.severity = none
# Integer is a kind of port, not a type name.
dotnet_diagnostic.CA1720.severity = none

# Private fields are camelCase with no underscore.
resharper_csharp_naming_rule.private_instance_fields = aaBb
resharper_csharp_naming_rule.private_static_fields = aaBb

# The compiler checks crefs (GenerateDocumentationFile); a member may document some parameters and not others.
resharper_invalid_xml_doc_comment_highlighting = none

# Plugins, commands and the container's services are made by reflection, and JSON
# reads and writes the records, so "unused" and "could be private" misfire here.
resharper_member_can_be_private_global_highlighting = hint
resharper_unused_member_global_highlighting = hint
resharper_class_never_instantiated_global_highlighting = hint
resharper_unused_type_global_highlighting = hint
resharper_not_accessed_positional_property_global_highlighting = hint
resharper_property_can_be_made_init_only_global_highlighting = hint
resharper_unused_method_return_value_global_highlighting = hint
resharper_unused_auto_property_accessor_global_highlighting = hint
# Sample and knob values are compared exactly on purpose.
resharper_compare_of_floats_by_equality_operator_highlighting = hint

[tests/**.cs]
# Test names are sentences.
dotnet_diagnostic.CA1707.severity = none
# An expected array is built once, for the one call that checks it.
dotnet_diagnostic.CA1861.severity = none
