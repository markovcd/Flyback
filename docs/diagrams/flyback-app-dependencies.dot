// Flyback.App composition root — construction-time dependencies.
// The canvas subsystem (17 classes) is collapsed to one NodeEditor node here;
// see canvas-internals.dot for what is inside it. Same edge data as
// flyback-app-dependencies.dot/.txt; layout is left to Graphviz's own ranking
// (by edge direction) rather than boxed subsystem groups, since a class's
// dependency depth and its "which subsystem" grouping don't line up — boxing
// them together forced unrelated-depth nodes onto the same row and produced
// far longer edges than letting the real dependency depth decide the row.
// Node fill color still marks the subsystem; see the legend node.
//
// Solid black edge = constructor parameter (DI). Dashed blue "lazy" = Lazy<T> (ADR-0150
// cycle-break). Dotted red "new" = built with `new` inside a ctor/field initializer, not DI.
//
// Usage and ReportLine (a telemetry sink and a status-line sink, both held like a logger)
// are omitted from all three files: nearly everything takes them, and drawing them added
// hubs with no structural meaning to trace.
digraph FlybackAppOverview {
  rankdir=TB;
  splines=spline;
  nodesep=0.3;
  ranksep=0.55;
  fontname="Helvetica";
  node [shape=box, style=filled, fillcolor=lightblue, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.6];

  legend [shape=plaintext, fontsize=10, label=<
    <table border="0" cellborder="1" cellspacing="0">
      <tr><td bgcolor="white">edge style</td><td>meaning</td></tr>
      <tr><td><font color="black">&#8594;</font></td><td align="left">constructor parameter (DI)</td></tr>
      <tr><td><font color="blue">- - &#8594;</font></td><td align="left">Lazy&lt;T&gt; parameter (deferred DI, breaks a cycle)</td></tr>
      <tr><td><font color="firebrick">&#183;&#183;&#183;&#8594;</font></td><td align="left">built with `new` in a ctor/field init — not DI</td></tr>
      <tr><td><font color="gray40">&#183;&#183;&#183;&#8594;</font></td><td align="left">interface registered against this implementation</td></tr>
    </table>
  >];

  MainWindow [style="filled,bold", fillcolor="#7fb2e5", penwidth=2, fontsize=13];
  NodeEditor [style="filled,bold", fillcolor="#b8d8ff", label="NodeEditor\n(canvas subsystem,\nsee canvas-internals.dot)"];

  // subsystem colors (cosmetic only — not a layout constraint)
  EditorSetup [fillcolor="#cfe2f3"]; PluginCatalog [fillcolor="#cfe2f3"];
  Document [fillcolor="#cfe2f3"]; SourceView [fillcolor="#cfe2f3"];
  Playback [fillcolor="#cfe2f3"]; AudioSetup [fillcolor="#cfe2f3"];

  EditorWindow [fillcolor="#d9d2e9"];
  WindowDialogs [fillcolor="#d9d2e9"]; WindowFilePickers [fillcolor="#d9d2e9"];
  WindowMonitors [fillcolor="#d9d2e9"]; WindowFocus [fillcolor="#d9d2e9"]; WindowClose [fillcolor="#d9d2e9"];

  PatchFiles [fillcolor="#d0e8d0"]; UnsavedWork [fillcolor="#d0e8d0"]; WorkKeeper [fillcolor="#d0e8d0"];
  FilesSection [fillcolor="#d0e8d0"]; PluginInstalls [fillcolor="#d0e8d0"]; SiteAccess [fillcolor="#d0e8d0"];

  OutputSections [fillcolor="#fce5cd"]; CanvasSection [fillcolor="#fce5cd"];
  UpdatesSection [fillcolor="#fce5cd"]; UsageSection [fillcolor="#fce5cd"];

  PresetThumbnails [fillcolor="#fff2cc"]; PresetAudition [fillcolor="#fff2cc"]; PresetSlot [fillcolor="#fff2cc"];

  PanelKnobs [fillcolor="#d9ead3"]; Palette [fillcolor="#d9ead3"]; Inspector [fillcolor="#d9ead3"];

  SeekBar [fillcolor="#ead1dc"]; Toolbar [fillcolor="#ead1dc"]; StatusBar [fillcolor="#ead1dc"]; TakeRecording [fillcolor="#ead1dc"];

  AssistantEditor [fillcolor="#f4cccc"]; AssistantPanel [fillcolor="#f4cccc"];

  // external (Flyback.Ui/Engine) leaves
  node [style="filled,dashed", color=gray40];
  IlCompiler [label="IlCompiler\n[ext]"];
  AudioEngine [label="AudioEngine\n[ext]"];
  MidiHub [label="MidiHub\n[ext]"];
  PreviewHost [label="PreviewHost\n[ext]"];
  PresetLibrary [label="PresetLibrary\n[ext]"];

  // interfaces
  node [shape=ellipse, style="filled,dashed", fillcolor=lightyellow, color=gray40];
  IMidiInput; IDialogs; IFilePickers; IMonitors; IWindowFocus; IWindowClose;
  IAssistantEditor; IServiceProvider [fillcolor=white]; IHttpClientFactory [fillcolor=white];

  node [shape=box, style=filled, fillcolor=lightblue, color=black];
  HttpClientSiteAccess [label="HttpClient\n\"SiteAccess.Client\""];

  // classes only ever built with `new`, never registered
  node [shape=box, style="filled,dashed", fillcolor=mistyrose, color=firebrick];
  Credentials; ProbeSection; SettingsForm; ControlHub; ControlsPanel; StageKnobs;
  GroupLibrary; ModulePalette; ModuleWash; ConversationStore; Transport; ThumbnailStore;
  Picker; SeekTrack; Shimmer;
  AudioRenderer [label="AudioRenderer\n[ext]"];
  ComputerKeyboard [label="ComputerKeyboard\n[ext]"];
  GpuPreviewSurface [label="GpuPreviewSurface\n[ext]"];
  PreviewSurface [label="PreviewSurface\n[ext]"];

  // --- interface -> implementation ---
  edge [style=dotted, color=gray40];
  IAssistantEditor -> AssistantEditor;
  IDialogs -> WindowDialogs;
  IFilePickers -> WindowFilePickers;
  IMonitors -> WindowMonitors;
  IWindowFocus -> WindowFocus;
  IWindowClose -> WindowClose;

  // --- constructor DI edges ---
  edge [style=solid, color=black, label="", fontcolor=black];

  MainWindow -> EditorSetup; MainWindow -> NodeEditor; MainWindow -> SourceView;
  MainWindow -> Document; MainWindow -> PatchFiles; MainWindow -> UnsavedWork;
  MainWindow -> PreviewHost; MainWindow -> PluginCatalog;
  MainWindow -> IlCompiler; MainWindow -> AudioEngine;
  MainWindow -> MidiHub; MainWindow -> Playback; MainWindow -> OutputSections;
  MainWindow -> CanvasSection; MainWindow -> UpdatesSection; MainWindow -> UsageSection;
  MainWindow -> FilesSection; MainWindow -> PanelKnobs; MainWindow -> Inspector;
  MainWindow -> PluginInstalls; MainWindow -> PresetSlot; MainWindow -> Toolbar;
  MainWindow -> StatusBar; MainWindow -> TakeRecording;
  MainWindow -> AssistantPanel [label="direct,\nnot lazy", fontcolor=black];
  MainWindow -> WorkKeeper;

  AssistantEditor -> NodeEditor; AssistantEditor -> Document; AssistantEditor -> PreviewHost;
  AssistantEditor -> PatchFiles;
  AssistantEditor -> PresetSlot [style=dashed, color=blue];

  AssistantPanel -> PluginCatalog; AssistantPanel -> IAssistantEditor;
  AssistantPanel -> EditorSetup;

  AudioEngine -> AudioSetup; AudioEngine -> IlCompiler;

  Document -> NodeEditor; Document -> SourceView;

  EditorWindow -> IServiceProvider;

  FilesSection -> EditorSetup;

  Inspector -> NodeEditor; Inspector -> Document; Inspector -> MidiHub;
  Inspector -> PanelKnobs; Inspector -> PatchFiles; Inspector -> Palette;
  Inspector -> IFilePickers;

  MidiHub -> IMidiInput;

  OutputSections -> PluginCatalog; OutputSections -> EditorSetup;
  OutputSections -> PresetSlot [style=dashed, color=blue];
  OutputSections -> IFilePickers; OutputSections -> IMonitors;

  Palette -> NodeEditor; Palette -> Document; Palette -> PluginCatalog;
  Palette -> PanelKnobs;
  Palette -> OutputSections; Palette -> EditorSetup;

  PanelKnobs -> NodeEditor; PanelKnobs -> Document;
  PanelKnobs -> PreviewHost; PanelKnobs -> AudioEngine; PanelKnobs -> MidiHub;

  PatchFiles -> NodeEditor; PatchFiles -> Document; PatchFiles -> PluginCatalog;
  PatchFiles -> AssistantPanel [style=dashed, color=blue];
  PatchFiles -> Playback; PatchFiles -> PluginInstalls; PatchFiles -> IFilePickers;

  Playback -> NodeEditor; Playback -> PluginCatalog;
  Playback -> AssistantPanel [style=dashed, color=blue];
  Playback -> PreviewHost; Playback -> AudioEngine; Playback -> IlCompiler;
  Playback -> MidiHub; Playback -> AudioSetup;
  Playback -> PatchFiles [style=dashed, color=blue];
  Playback -> TakeRecording [style=dashed, color=blue];

  PluginInstalls -> PluginCatalog;
  PluginInstalls -> AssistantPanel [style=dashed, color=blue];
  PluginInstalls -> EditorSetup; PluginInstalls -> SiteAccess; PluginInstalls -> Playback;
  PluginInstalls -> UnsavedWork [style=dashed, color=blue];
  PluginInstalls -> IDialogs;

  PresetAudition -> AudioEngine; PresetAudition -> IlCompiler; PresetAudition -> PluginCatalog;
  PresetAudition -> PresetLibrary; PresetAudition -> Playback;
  PresetAudition -> TakeRecording [style=dashed, color=blue];

  PresetLibrary -> EditorSetup [label="IPresetFolder", fontcolor=gray40, color=gray40];

  PresetSlot -> NodeEditor; PresetSlot -> Document; PresetSlot -> PluginCatalog;
  PresetSlot -> AssistantPanel [style=dashed, color=blue];
  PresetSlot -> PatchFiles; PresetSlot -> PresetThumbnails; PresetSlot -> PresetAudition;
  PresetSlot -> PresetLibrary; PresetSlot -> SiteAccess; PresetSlot -> UnsavedWork;
  PresetSlot -> Playback; PresetSlot -> PluginInstalls; PresetSlot -> IDialogs;

  PresetThumbnails -> PluginCatalog; PresetThumbnails -> IlCompiler;
  PresetThumbnails -> EditorSetup; PresetThumbnails -> PresetLibrary;

  SeekBar -> Playback; SeekBar -> PreviewHost; SeekBar -> CanvasSection;
  SeekBar -> NodeEditor; SeekBar -> Document;

  SiteAccess -> EditorSetup; SiteAccess -> IHttpClientFactory;

  StatusBar -> NodeEditor; StatusBar -> PluginCatalog;
  StatusBar -> PreviewHost; StatusBar -> SiteAccess;
  StatusBar -> Playback; StatusBar -> IDialogs; StatusBar -> IWindowFocus;

  TakeRecording -> Toolbar; TakeRecording -> OutputSections; TakeRecording -> PreviewHost;
  TakeRecording -> AudioEngine; TakeRecording -> NodeEditor;
  TakeRecording -> Playback;

  Toolbar -> PresetSlot; Toolbar -> PluginCatalog; Toolbar -> SeekBar;

  UnsavedWork -> NodeEditor; UnsavedWork -> Document;
  UnsavedWork -> AssistantPanel [style=dashed, color=blue];
  UnsavedWork -> PatchFiles;
  UnsavedWork -> TakeRecording [style=dashed, color=blue];
  UnsavedWork -> EditorSetup; UnsavedWork -> IDialogs; UnsavedWork -> IWindowClose;

  UpdatesSection -> EditorSetup;

  UsageSection -> EditorSetup;

  WindowDialogs -> EditorWindow; WindowFilePickers -> EditorWindow;
  WindowMonitors -> EditorWindow; WindowFocus -> EditorWindow; WindowClose -> EditorWindow;

  WorkKeeper -> EditorSetup; WorkKeeper -> UnsavedWork;

  // --- direct construction, not DI ---
  edge [style=dotted, color=firebrick];
  AssistantPanel -> Credentials; AssistantPanel -> ProbeSection; AssistantPanel -> SettingsForm;
  AudioEngine -> AudioRenderer;
  Inspector -> ModuleWash;
  MidiHub -> ComputerKeyboard;
  Palette -> GroupLibrary; Palette -> ModulePalette;
  PanelKnobs -> ControlHub; PanelKnobs -> ControlsPanel; PanelKnobs -> StageKnobs;
  PatchFiles -> ConversationStore;
  Playback -> Transport;
  PresetThumbnails -> ThumbnailStore [label="new\n(conditional)"];
  PresetSlot -> Picker;
  PreviewHost -> GpuPreviewSurface; PreviewHost -> PreviewSurface;
  SeekBar -> SeekTrack;
  StatusBar -> Shimmer;
  OutputSections -> Picker [label="new (x10)"];
}
