{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8777", "--directory", "site"],
      "port": 8777
    },
    {
      "name": "presets",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Flyback.Server"],
      "port": 8790
    },
    {
      "name": "worker",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["worker/dev.sh"],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Flyback.Viewer.Web"],
      "port": 8795
    }
  ]
}
