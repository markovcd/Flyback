<?xml version="1.0" encoding="utf-8"?>

<!--
  What the coverage run measures, and how.

  Instrumentation is dynamic only: the assemblies are rewritten in memory as they
  load, never on disk. Static instrumentation rewrites the files, and a shipped
  plugin whose files differ from plugins.sha256 is refused, which leaves the
  plugin tests with no plugins.

  The two excluded assemblies are test fixtures, not part of Flyback.
-->

<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <EnableStaticManagedInstrumentation>False</EnableStaticManagedInstrumentation>
            <EnableDynamicManagedInstrumentation>True</EnableDynamicManagedInstrumentation>
            <ModulePaths>
              <Exclude>
                <ModulePath>.*Flyback\.Plugins\.Sample\.dll$</ModulePath>
                <ModulePath>.*Flyback\.Plugins\.FakeAssistant\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
