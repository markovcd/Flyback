<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Drives real controls through Avalonia's headless platform: see Ui/EditorTest.cs for what a UI test costs. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Flyback.Editor\Flyback.Editor.csproj" />
    <ProjectReference Include="..\..\src\Flyback.Ui\Flyback.Ui.csproj" />
    <ProjectReference Include="..\..\src\Flyback.Viewer.Desktop\Flyback.Viewer.Desktop.csproj" />
  </ItemGroup>

  <!--
    Referenced directly rather than loaded from a plugins/ folder: PluginGlyphsTests
    wants every shipped plugin's NodeDefs to check their marks, and this assembly
    builds no plugins/ folder of its own for PluginHost.Load() to find (that is
    Flyback.Editor.Desktop's, and Flyback.Plugins.Tests's).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\plugins\Flyback.Plugins.Picture\Flyback.Plugins.Picture.csproj" />
    <ProjectReference Include="..\..\src\plugins\Flyback.Plugins.Voice\Flyback.Plugins.Voice.csproj" />
    <ProjectReference Include="..\..\src\plugins\Flyback.Plugins.Effects\Flyback.Plugins.Effects.csproj" />
    <ProjectReference Include="..\..\src\plugins\Flyback.Plugins.Mastering\Flyback.Plugins.Mastering.csproj" />

    <!-- Not in the box: the preset site starts with these, and their previews are retaken here like the others'. -->
    <ProjectReference Include="..\..\src\plugins\Flyback.Plugins.Figures\Flyback.Plugins.Figures.csproj" />
    <ProjectReference Include="..\..\src\plugins\Flyback.Plugins.Fractals\Flyback.Plugins.Fractals.csproj" />
    <ProjectReference Include="..\..\src\plugins\Flyback.Plugins.Easy\Flyback.Plugins.Easy.csproj" />
    <ProjectReference Include="..\..\src\plugins\Flyback.Plugins.Drawings\Flyback.Plugins.Drawings.csproj" />

    <!-- The worked example, whose project sets everything a package can say about a plugin. -->
    <ProjectReference Include="..\Flyback.Plugins.Sample\Flyback.Plugins.Sample.csproj" />

    <!-- A real plugin that sets no tags and embeds no preview. -->
    <ProjectReference Include="..\Flyback.Plugins.FakeAssistant\Flyback.Plugins.FakeAssistant.csproj" />
    <ProjectReference Include="..\Flyback.Plugins.FakeDecider\Flyback.Plugins.FakeDecider.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flyback.Ui.Testing\Flyback.Ui.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <!-- Reading a take back through ffmpeg, as the clip writer's own tests do. -->
  <ItemGroup>
    <Compile Include="..\Flyback.Core.Tests\Rendering\Decoded.cs" Link="Capture\Decoded.cs" />
  </ItemGroup>

  <!-- Where the checkout is, for tests that read its files. -->
  <ItemGroup>
    <Compile Include="..\Shared\Repository.cs" Link="Shared\Repository.cs" />
  </ItemGroup>

</Project>
