<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!--
    Two halves, and they run the same way. One is the part of the shell that
    joins a compiled program to a sound device and touches no UI type at all;
    the other drives real controls through Avalonia's headless platform, which
    lays out and renders without a window server. Both are ordinary tests — see
    Ui/UiTest.cs for what a UI one costs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Flyback.App\Flyback.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <!--
      Held at 3.x: Avalonia.Headless.XUnit is compiled against xunit.v3 3.2.2's
      extensibility core, and its discoverer throws MissingMethodException on
      4.x. Moves when Avalonia ships a build against it.
    -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <!--
    Headless gives layout, input and rendering with no window server. The Skia
    reference is what makes CaptureRenderedFrame produce actual pixels rather
    than throwing: the default headless drawing backend does no rasterising, and
    a test that cannot see what it drew is the kind that passed while the number
    boxes in the step list rendered empty.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

</Project>
