<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flyback.Plugins\Flyback.Plugins.csproj" />

    <!--
      The contract keeps the engine to itself, so a test that compiles what a
      plugin's module lowers to has to ask for it by name.
    -->
    <ProjectReference Include="..\..\src\Flyback.Engine\Flyback.Engine.csproj" />
  </ItemGroup>

  <!--
    The loading tests run against the real shipped plugin rather than a stub, so
    the thing under test is the one that has to work: a separate assembly, its
    own dependencies, and a dependency file the resolver has to read.
  -->
  <ItemGroup>
    <!--
      Every platform plugin and every credential store, on every operating
      system: what these tests pin is that a plugin for another platform still
      loads and still answers, so leaving one out where it cannot work would
      remove the case under test.
    -->
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.WinIO\Flyback.Plugins.WinIO.csproj" FolderName="WinIO" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.MacIO\Flyback.Plugins.MacIO.csproj" FolderName="MacIO" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.LinuxIO\Flyback.Plugins.LinuxIO.csproj" FolderName="LinuxIO" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Dpapi\Flyback.Plugins.Dpapi.csproj" FolderName="Dpapi" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Keychain\Flyback.Plugins.Keychain.csproj" FolderName="Keychain" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Keyring\Flyback.Plugins.Keyring.csproj" FolderName="Keyring" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.OpenAi\Flyback.Plugins.OpenAi.csproj" FolderName="OpenAi" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Gemini\Flyback.Plugins.Gemini.csproj" FolderName="Gemini" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.ClaudeCode\Flyback.Plugins.ClaudeCode.csproj" FolderName="ClaudeCode" />
    <PluginProject Include="..\Flyback.Plugins.Sample\Flyback.Plugins.Sample.csproj" FolderName="Sample" />
    <PluginProject Include="..\Flyback.Plugins.FakeAssistant\Flyback.Plugins.FakeAssistant.csproj" FolderName="FakeAssistant" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Picture\Flyback.Plugins.Picture.csproj" FolderName="Picture" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Voice\Flyback.Plugins.Voice.csproj" FolderName="Voice" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Effects\Flyback.Plugins.Effects.csproj" FolderName="Effects" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Mastering\Flyback.Plugins.Mastering.csproj" FolderName="Mastering" />
    <!-- Not in the box: the preset site starts with these, and they are tested here the way an install loads them. -->
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Figures\Flyback.Plugins.Figures.csproj" FolderName="Figures" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Fractals\Flyback.Plugins.Fractals.csproj" FolderName="Fractals" />
    <PluginProject Include="..\..\src\plugins\Flyback.Plugins.Easy\Flyback.Plugins.Easy.csproj" FolderName="Easy" />
  </ItemGroup>

  <!-- The preset site's defaults, which have to open and compile against the plugins above (ADR-0138). -->
  <ItemGroup>
    <None Include="..\..\src\Flyback.Server\Defaults\**" LinkBase="Defaults" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
