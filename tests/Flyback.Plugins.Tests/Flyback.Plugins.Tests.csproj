<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flyback.Plugins\Flyback.Plugins.csproj" />
  </ItemGroup>

  <!--
    The loading tests run against the real shipped plugin rather than a stub, so
    the thing under test is the one that has to work: a separate assembly, its
    own dependencies, and a dependency file the resolver has to read.
  -->
  <ItemGroup>
    <!--
      Every platform backend and every credential store, on every operating
      system: what these tests pin is that a plugin for another platform still
      loads and still answers, so leaving one out where it cannot work would
      remove the case under test.
    -->
    <PluginProject Include="..\..\src\Flyback.Plugins.Wasapi\Flyback.Plugins.Wasapi.csproj" FolderName="Wasapi" />
    <PluginProject Include="..\..\src\Flyback.Plugins.CoreAudio\Flyback.Plugins.CoreAudio.csproj" FolderName="CoreAudio" />
    <PluginProject Include="..\..\src\Flyback.Plugins.Alsa\Flyback.Plugins.Alsa.csproj" FolderName="Alsa" />
    <PluginProject Include="..\..\src\Flyback.Plugins.Dpapi\Flyback.Plugins.Dpapi.csproj" FolderName="Dpapi" />
    <PluginProject Include="..\..\src\Flyback.Plugins.Keychain\Flyback.Plugins.Keychain.csproj" FolderName="Keychain" />
    <PluginProject Include="..\..\src\Flyback.Plugins.Keyring\Flyback.Plugins.Keyring.csproj" FolderName="Keyring" />
    <PluginProject Include="..\..\src\Flyback.Plugins.WinMidi\Flyback.Plugins.WinMidi.csproj" FolderName="WinMidi" />
    <PluginProject Include="..\..\src\Flyback.Plugins.CoreMidi\Flyback.Plugins.CoreMidi.csproj" FolderName="CoreMidi" />
    <PluginProject Include="..\..\src\Flyback.Plugins.AlsaMidi\Flyback.Plugins.AlsaMidi.csproj" FolderName="AlsaMidi" />
    <PluginProject Include="..\..\src\Flyback.Plugins.OpenAi\Flyback.Plugins.OpenAi.csproj" FolderName="OpenAi" />
    <PluginProject Include="..\Flyback.Plugins.Sample\Flyback.Plugins.Sample.csproj" FolderName="Sample" />
    <PluginProject Include="..\Flyback.Plugins.FakeAssistant\Flyback.Plugins.FakeAssistant.csproj" FolderName="FakeAssistant" />
    <PluginProject Include="..\..\src\Flyback.Plugins.Supersaw\Flyback.Plugins.Supersaw.csproj" FolderName="Supersaw" />
    <PluginProject Include="..\..\src\Flyback.Plugins.Space\Flyback.Plugins.Space.csproj" FolderName="Space" />
    <PluginProject Include="..\..\src\Flyback.Plugins.Timbre\Flyback.Plugins.Timbre.csproj" FolderName="Timbre" />
    <PluginProject Include="..\..\src\Flyback.Plugins.Modulation\Flyback.Plugins.Modulation.csproj" FolderName="Modulation" />
    <PluginProject Include="..\..\src\Flyback.Plugins.Shapes\Flyback.Plugins.Shapes.csproj" FolderName="Shapes" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

</Project>
