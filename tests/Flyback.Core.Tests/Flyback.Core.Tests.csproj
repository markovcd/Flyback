<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!--
    xunit.v3 ships its own in-process runner on Microsoft.Testing.Platform, and
    global.json points `dotnet test` at that platform rather than at VSTest.
    Microsoft.NET.Test.Sdk is deliberately absent from every test project here —
    it would switch them back.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flyback.Core\Flyback.Core.csproj" />
    <ProjectReference Include="..\..\src\Flyback.Engine\Flyback.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Verify.ImageMagick" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
