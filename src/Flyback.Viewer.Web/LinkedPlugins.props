<Project>

  <!--
    The plugins the web viewer and editor link in, and the preset site checks a shared
    preset against: the ones that make modules, and none that talks to a device, a
    keychain or a model. A page cannot load plugins from a folder, so this is all it has.
  -->
  <ItemGroup>
    <WebPlugin Include="$(MSBuildThisFileDirectory)..\plugins\Flyback.Plugins.Effects\Flyback.Plugins.Effects.csproj" />
    <WebPlugin Include="$(MSBuildThisFileDirectory)..\plugins\Flyback.Plugins.Mastering\Flyback.Plugins.Mastering.csproj" />
    <WebPlugin Include="$(MSBuildThisFileDirectory)..\plugins\Flyback.Plugins.Picture\Flyback.Plugins.Picture.csproj" />
    <WebPlugin Include="$(MSBuildThisFileDirectory)..\plugins\Flyback.Plugins.Voice\Flyback.Plugins.Voice.csproj" />
  </ItemGroup>

  <!-- The preset site's plugins, linked only in All plugins: every visit downloads what is linked in. -->
  <ItemGroup>
    <SitePlugin Include="$(MSBuildThisFileDirectory)..\plugins\Flyback.Plugins.Easy\Flyback.Plugins.Easy.csproj" />
    <SitePlugin Include="$(MSBuildThisFileDirectory)..\plugins\Flyback.Plugins.Figures\Flyback.Plugins.Figures.csproj" />
    <SitePlugin Include="$(MSBuildThisFileDirectory)..\plugins\Flyback.Plugins.Fractals\Flyback.Plugins.Fractals.csproj" />
    <SitePlugin Include="$(MSBuildThisFileDirectory)..\plugins\Flyback.Plugins.Drawings\Flyback.Plugins.Drawings.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'All plugins'">
    <WebPlugin Include="@(SitePlugin)" />
  </ItemGroup>

</Project>
