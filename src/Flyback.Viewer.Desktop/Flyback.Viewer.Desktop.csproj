<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A console subsystem program, for the reason the shell is one: started from a
      terminal it inherits the terminal, so stderr is read by whoever typed the
      command and the prompt waits. See Flyback.Editor.Desktop.csproj.
    -->
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>flyback-viewer</AssemblyName>
    <RootNamespace>Flyback.Viewer.Desktop</RootNamespace>
    <ApplicationIcon>..\..\flyback.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Published into the shell's own folder beside flyback-cli, and self-contained
    for the same reason: three front ends on one engine, one plugin host and one
    runtime, held once.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <!-- Shares a folder with the editor, whose PublishReadyToRun says why; a plain copy of a shared assembly would replace its compiled one. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flyback.Core\Flyback.Core.csproj" />
    <ProjectReference Include="..\Flyback.Engine\Flyback.Engine.csproj" />
    <ProjectReference Include="..\Flyback.Plugins\Flyback.Plugins.csproj" />
    <ProjectReference Include="..\Flyback.Host\Flyback.Host.csproj" />
    <ProjectReference Include="..\Flyback.Ui\Flyback.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.CommandLine" />
    <!--
      The editor's Skia and HarfBuzz, which its SVG controls take newer than Avalonia does:
      both are published into one folder, and every copy of a shared library must be one version.
    -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>

  <!--
    No PluginProject items, for the CLI's reason exactly: the target that lays the
    plugin folder out clears it first, so a third program declaring them would
    take the shell's sound backends away on its way past. The shell ships them,
    and this program reads the folder beside it. In All plugins the editor's
    folder is copied beside this build (Directory.Build.targets).
  -->
  <PropertyGroup>
    <EditorPlugins>true</EditorPlugins>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flyback.Editor.Tests" />
    <InternalsVisibleTo Include="Flyback.Ui.Tests" />
    <InternalsVisibleTo Include="Flyback.Viewer.Desktop.Tests" />
    <InternalsVisibleTo Include="Flyback.Editor.Desktop.Tests" />
    <InternalsVisibleTo Include="Flyback.Specs" />
  </ItemGroup>

</Project>
