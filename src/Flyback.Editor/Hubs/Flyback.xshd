<?xml version="1.0" encoding="utf-8"?>

<!--
  The Flyback language, colored. Written by hand rather than taken from a
  grammar registry, because no registry has heard of this language and one of
  these has to be written either way — see docs/language.md and ADR-0065.
  site/static/assets/site.js colors snippets on the site by the same rules.

  The colors are the shell's own (Controls/Colors.cs) so the text view reads as
  part of the program rather than as an editor bolted into it. What each one
  means is the same thing it means on the canvas wherever there is a
  correspondence: a socket name is the pale label a socket carries on a node,
  and the Output is the sink's red.

  A span's start outranks any rule that would run across it, so the comment
  begins at a '#' that is not the sharp of a note.
-->
<SyntaxDefinition name="Flyback" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <Color name="Comment"  foreground="#6C7482" />
  <Color name="Keyword"  foreground="#3FC8C8" fontWeight="bold" />
  <Color name="Pipe"     foreground="#E06AB8" fontWeight="bold" />
  <Color name="Sink"     foreground="#E05A5A" />
  <Color name="Domain"   foreground="#4A9EDE" />
  <Color name="Socket"   foreground="#A8CE52" />
  <Color name="Module"   foreground="#B484E0" />
  <Color name="Number"   foreground="#E0A84A" />
  <Color name="Text"     foreground="#4FC387" />

  <RuleSet ignoreCase="false">

    <Span color="Comment" begin="#(?!(?&lt;=\b[A-G]#)-?\d)" />

    <!-- The one string the language has, which names a file or says something about the patch. -->
    <Span color="Text" begin="&quot;" end="&quot;" />

    <!-- A module's step or arrangement block, or a list. -->
    <Span ruleSet="Block" multiline="true" begin="\[" end="\]" />

    <Import ruleSet="Code" />

  </RuleSet>

  <!--
    Inside brackets a note may leave out its octave (a tune's or a keyboard's
    scale), '#' is its sharp, and the step and arrangement notation has
    operators of its own: a rest, velocity, repeat, elongate, alternation and
    the bar between parts.
  -->
  <RuleSet name="Block" ignoreCase="false">

    <Span color="Comment" begin="#(?&lt;!\b[A-G]#)" />
    <Span color="Text" begin="&quot;" end="&quot;" />
    <Span ruleSet="Block" multiline="true" begin="\[" end="\]" />

    <Rule color="Number">\b[A-G][#b]?(?:-?\d+)?(?![\w#])</Rule>

    <Rule color="Comment">~</Rule>

    <Rule color="Pipe">\|&gt;|&lt;-|\.\.\.?|\b_\b|[|&lt;&gt;!@%]</Rule>

    <Import ruleSet="Code" />

  </RuleSet>

  <RuleSet name="Code" ignoreCase="false">

    <Rule color="Keyword">\b(?:let|def|group|for|off)\b</Rule>

    <!-- A loop's "in", which is never the socket of that name nor a def's parameter. -->
    <Rule color="Keyword">\bin\b(?=\s+(?:[^\s:,)=.]|$))</Rule>

    <!--
      The lines about the whole patch, each told from a name by what follows it.
      A rule sees only up to where a text, a comment or a block begins, so the
      end of what it sees stands for the quote or the bracket.
    -->
    <Rule color="Keyword">\b(?:description|author|tags)\b(?=\s+(?:"|$))</Rule>
    <Rule color="Keyword">\brequires\b(?=\s+(?:["\w]|$))</Rule>
    <Rule color="Keyword">\bpanel\b(?=\s+\w+\s*=)</Rule>
    <Rule color="Keyword">\b(?:held|switch|button|latching)\b(?=\s*(?:,|$))</Rule>
    <Rule color="Keyword">\bkeyboard\s+(?:piano|scale)\b</Rule>
    <Rule color="Keyword">\blength\b(?=\s+\d)</Rule>

    <!-- The Output, which every patch has exactly one of. -->
    <Rule color="Sink">\bout\s*\.\s*\w+</Rule>

    <!--
      The domains. They are not modules and are not spelled like them: x, y and
      t are the three things a patch is read across, and coloring them as
      sources is what makes a line that never moves visible at a glance. A
      socket or a module of the same name is not one.
    -->
    <Rule color="Domain">\b(?:x|y|t|radius|angle|aspect)\b(?!\s*[:(])</Rule>

    <!-- A named argument, which is a socket on the module being called. -->
    <Rule color="Socket">\b[A-Za-z_]\w*\s*(?=:)</Rule>

    <!-- A note, which the language reads as the number it is. -->
    <Rule color="Number">\b[A-G][#b]?-?\d+\b</Rule>

    <!--
      Anything being called, which is a module or a def and is deliberately not
      told apart from one: both are a stage in a pipeline and both read as one.
      Matched by the bracket after the name rather than against the catalog,
      because a plugin's modules are usable the moment it loads and a list here
      would be one more thing that could go stale — the same reason the binder
      reads the catalog rather than a table (ADR-0065).
    -->
    <Rule color="Module">\b[A-Za-z_]\w*(?=\s*\()</Rule>

    <!--
      The pipe, the back-wire, the range that fills two sockets at once, the
      spread of a list over a call's sockets, and the "_" that says where a pipe lands.
    -->
    <Rule color="Pipe">\|&gt;|&lt;-|\.\.\.?|\b_\b</Rule>

    <Rule color="Number">\b\d+(?:\.\d+)?(?:us|ms|s)?\b</Rule>

  </RuleSet>

</SyntaxDefinition>
