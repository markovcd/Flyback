<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Flyback</string>

  <key>CFBundleDisplayName</key>
  <string>Flyback</string>

  <!-- The apphost the SDK produces, which is named after AssemblyName. -->
  <key>CFBundleExecutable</key>
  <string>Flyback</string>

  <key>CFBundleIdentifier</key>
  <string>io.github.markovcd.flyback</string>

  <key>CFBundleIconFile</key>
  <string>flyback.icns</string>

  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <!-- Substituted by MacBundle.targets with $(Version), stripped to major.minor.patch. -->
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>

  <key>CFBundleVersion</key>
  <string>__VERSION__</string>

  <!-- Without this the window is scaled up from 1x and the preview looks soft. -->
  <key>NSHighResolutionCapable</key>
  <true/>

  <!--
    The application is the window: it belongs in the Dock and owns the menu bar,
    rather than running as a background process the way a bare executable does.
  -->
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.music</string>

  <!-- The oldest macOS the .NET 10 runtime supports. -->
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>

  <!--
    What lets Finder open one of the three kinds of file this program reads by
    double-click, by "Open With", or by a drag onto the Dock icon — none of
    which pass a file on the command line the way Windows and Linux do.
    FlybackApp.OnFrameworkInitializationCompleted is the other half: what
    Finder sends over is an activation, not an argument.
  -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Flyback patch</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>fbk</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>flyback.icns</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Flyback bundle</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>fbkb</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>flyback.icns</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Flyback text</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>fbks</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>flyback.icns</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
    </dict>
  </array>
</dict>
</plist>
