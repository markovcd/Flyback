<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The editor in a browser (ADR-0162): Flyback.Editor under Avalonia.Browser, with
    the picture on a canvas of its own. Needs the wasm-tools workload, which links
    Skia and HarfBuzz into the runtime, as the whole solution does. The preset
    site publishes it beside itself and serves it at /editor/,
    beside the web viewer whose GL calls it makes, unless built with -p:EditorWeb=false.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Flyback.Editor.Web</RootNamespace>

    <!-- As the web viewer: ahead-of-time compiled only when a publish asks. -->
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">false</RunAOTCompilation>

    <!-- As the web viewer: the patch reader deserializes by reflection, so Flyback is not trimmed. -->
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- As the web viewer: the packages the WebAssembly SDK adds are versioned with it. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
    <!-- The natives Avalonia.Browser brings are older than the managed SkiaSharp the editor resolves. -->
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flyback.Editor\Flyback.Editor.csproj" />
    <ProjectReference Include="..\Flyback.Gpu\Flyback.Gpu.csproj" />
  </ItemGroup>

  <!-- The web viewer's plugins. -->
  <Import Project="..\Flyback.Viewer.Web\LinkedPlugins.props" />

  <ItemGroup>
    <ProjectReference Include="@(WebPlugin)" LinkedPlugin="true" />
  </ItemGroup>

</Project>
