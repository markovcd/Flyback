<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The namespaces are Core's, and stay that way: a namespace says what a type
      is about and an assembly says who may see it. The compiler and the emitter
      a module writes to are both about compiling; only one of them is something
      a plugin is handed.
    -->
    <RootNamespace>Flyback.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      One way only. Core is what a plugin is compiled against, so nothing in it
      may need anything here — which is what keeps this assembly free to change
      between releases without a plugin noticing.
    -->
    <ProjectReference Include="..\Flyback.Core\Flyback.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Graph\Presets.WholeBand.cs">
      <DependentUpon>Presets.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Whatever names Core's internals is shared with the assemblies Core shares them with. -->
    <InternalsVisibleTo Include="Flyback.Plugins" />
    <InternalsVisibleTo Include="Flyback.Ui" />
    <InternalsVisibleTo Include="Flyback" />
    <InternalsVisibleTo Include="flyback-cli" />
    <InternalsVisibleTo Include="flyback-viewer" />
    <InternalsVisibleTo Include="Flyback.Server" />
    <InternalsVisibleTo Include="Flyback.Core.Tests" />
    <InternalsVisibleTo Include="Flyback.Core.Benchmarks" />
    <InternalsVisibleTo Include="Flyback.Plugins.Tests" />
    <InternalsVisibleTo Include="Flyback.App.Tests" />
    <InternalsVisibleTo Include="Flyback.Cli.Tests" />
    <InternalsVisibleTo Include="Flyback.Server.Tests" />
    <InternalsVisibleTo Include="Flyback.Specs" />
  </ItemGroup>

</Project>
