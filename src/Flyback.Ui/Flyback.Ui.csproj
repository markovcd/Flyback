<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the two windows that play a patch draw and sound with: the preview, the
    sound device and the look (ADR-0124). What every host reads with no window,
    the settings and the presets, is Flyback.Host's (ADR-0188).

    Avalonia itself and nothing that belongs to only one shell: the editor's code
    view and SVG artwork stay with the editor.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Flyback.Ui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flyback.Core\Flyback.Core.csproj" />
    <ProjectReference Include="..\Flyback.Engine\Flyback.Engine.csproj" />
    <ProjectReference Include="..\Flyback.Gpu\Flyback.Gpu.csproj" />
    <ProjectReference Include="..\Flyback.Plugins\Flyback.Plugins.csproj" />
    <ProjectReference Include="..\Flyback.Host\Flyback.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />

    <!-- For TransportServices, the part of the editor's and the viewer's containers they share (ADR-0150). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />

    <!-- For the driver both programs start Windows on; see GraphicsDrivers. Not passed on: the desktop shells get it from Avalonia.Desktop, and the web editor must not ship it. -->
    <PackageReference Include="Avalonia.Win32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flyback" />
    <InternalsVisibleTo Include="Flyback.Editor" />
    <InternalsVisibleTo Include="flyback-viewer" />
    <InternalsVisibleTo Include="Flyback.Editor.Web" />
    <InternalsVisibleTo Include="Flyback.Editor.Android" />
    <InternalsVisibleTo Include="Flyback.Editor.Tests" />
    <InternalsVisibleTo Include="Flyback.Ui.Tests" />
    <InternalsVisibleTo Include="Flyback.Viewer.Desktop.Tests" />
    <InternalsVisibleTo Include="Flyback.Editor.Desktop.Tests" />
    <InternalsVisibleTo Include="Flyback.Specs" />
  </ItemGroup>

</Project>
