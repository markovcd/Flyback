<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Flyback.Plugins.Easy</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- What the install dialog and the plugins window show. -->
    <Product>Easy</Product>
    <Authors>Flyback</Authors>
    <Description>Easy Synth, a whole synth in one module that sounds good before anything is wired: a wave picked from a list, an envelope, a filter that follows the note, two LFOs, a sub, noise, glide, drive and pan, and no setting that can make it clip. With First notes, a riff played on it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Tags" Value="sound; synth; beginner; envelope; filter; lfo" />
    <!-- Retaken by PluginPreviewShotTests. -->
    <EmbeddedResource Include="preview.webp" LogicalName="preview.webp" Condition="Exists('preview.webp')" />
    <!-- The pictures behind the module (ADR-0118), read out of the assembly by Art. -->
    <EmbeddedResource Include="Art\*.svg" LogicalName="art.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both are host-owned; shipping either would give its types a second identity. -->
    <ProjectReference Include="..\Flyback.Plugins\Flyback.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
    <ProjectReference Include="..\Flyback.Core\Flyback.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
  </ItemGroup>

</Project>
