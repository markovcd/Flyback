<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Flyback.Plugins.Keyring</RootNamespace>
    <!--
      Emits the .deps.json the host's AssemblyDependencyResolver reads, which is
      also what marks the entry assembly among the files in the plugin folder.
      There is nothing to resolve — this plugin drives a program that comes with
      the desktop keyring rather than with us — but the dependency file is still
      what makes the folder identifiable as a plugin.
    -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Both are host-owned; shipping either would give its types a second
      identity. Core is named even though this plugin does not use it, because
      the contract references it and a transitive reference is copied local
      unless it is suppressed here too.
    -->
    <ProjectReference Include="..\Flyback.Plugins\Flyback.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
    <ProjectReference Include="..\Flyback.Core\Flyback.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
  </ItemGroup>

</Project>
