<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Flyback.Plugins.Fractals</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- What the install dialog and the plugins window show. -->
    <Product>Fractals</Product>
    <Authors>Flyback</Authors>
    <Description>Three modules about one point c: the Mandelbrot set, which maps every c; the Julia set of c, its picture; and the orbit of c, its sound. In the classic colors, with Dive, a zoom into Seahorse Valley, and Julia walk, a c going round a circle seen and heard.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Tags" Value="fractal; mandelbrot; julia; chaos; picture and sound" />
    <!-- Retaken by PluginPreviewShotTests. -->
    <EmbeddedResource Include="preview.webp" LogicalName="preview.webp" Condition="Exists('preview.webp')" />
    <!-- The pictures behind the modules (ADR-0118), read out of the assembly by Art. -->
    <EmbeddedResource Include="Art\*.png" LogicalName="art.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both are host-owned; shipping either would give its types a second identity. -->
    <ProjectReference Include="..\Flyback.Plugins\Flyback.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
    <ProjectReference Include="..\Flyback.Core\Flyback.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
  </ItemGroup>

</Project>
