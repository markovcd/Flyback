<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Flyback.Plugins.Dpapi</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both are host-owned; shipping either would give its types a second identity. -->
    <ProjectReference Include="..\Flyback.Plugins\Flyback.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
    <ProjectReference Include="..\Flyback.Core\Flyback.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Compiles anywhere and refuses at run time everywhere but Windows, which is
      why this project stays on plain net10.0 and answers IsSupported honestly
      rather than failing to build for a machine it was never meant to run on.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
