<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Flyback.Plugins</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <!-- Half of what a plugin is compiled against; see Directory.Build.props. -->
    <AssemblyVersion>$(PluginContractVersion)</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- A module is engine data, so contributing one means speaking Core's types. -->
    <ProjectReference Include="..\Flyback.Core\Flyback.Core.csproj" />

    <!--
      What the host and the workbench run a patch with, and nothing a plugin is
      handed. Private, so it does not flow on to whatever references this
      assembly: a plugin is compiled against Core and this, and one that reached
      for the engine through here would fail to build rather than ship bound to
      a release.
    -->
    <ProjectReference Include="..\Flyback.Engine\Flyback.Engine.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- PluginCatalog is built by the host, so its constructor is not public.
         The shell's tests need it too: a panel that shows what a provider can do
         cannot be tested in front of no provider, and everything it got wrong
         was in that half. -->
    <InternalsVisibleTo Include="Flyback.Plugins.Tests" />
    <InternalsVisibleTo Include="Flyback.App.Tests" />
    <InternalsVisibleTo Include="Flyback.Cli.Tests" />

    <!-- A plugin package is read, and written, by the editor and the command line. -->
    <InternalsVisibleTo Include="Flyback" />
    <InternalsVisibleTo Include="flyback-cli" />
    <InternalsVisibleTo Include="Flyback.Presets.Server" />
  </ItemGroup>

  <ItemGroup>
    <!--
      CategoryAccents is shared rather than public: a plugin in this repository
      may match a category's exact accent, but nothing here promises a
      third-party one the same color forever.
    -->
    <InternalsVisibleTo Include="Flyback.Plugins.Picture" />
    <InternalsVisibleTo Include="Flyback.Plugins.Voice" />
    <InternalsVisibleTo Include="Flyback.Plugins.Effects" />
    <InternalsVisibleTo Include="Flyback.Plugins.Mastering" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assist\priority-modules.txt" LogicalName="priority-modules.txt" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Assist\PatchWorkbench.Senses.cs">
      <DependentUpon>PatchWorkbench.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!--
      Holds the public surface to PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt
      beside this file, which is what a plugin is compiled against written down.
      It runs in the compiler and is gone from what is built: nothing here
      references it, and nothing is shipped because of it.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
