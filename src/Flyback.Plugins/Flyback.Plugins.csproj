<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Flyback.Plugins</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- A module is engine data, so contributing one means speaking Core's types. -->
    <ProjectReference Include="..\Flyback.Core\Flyback.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PluginCatalog is built by the host, so its constructor is not public.
         The shell's tests need it too: a panel that shows what a provider can do
         cannot be tested in front of no provider, and everything it got wrong
         was in that half. -->
    <InternalsVisibleTo Include="Flyback.Plugins.Tests" />
    <InternalsVisibleTo Include="Flyback.App.Tests" />
  </ItemGroup>

</Project>
