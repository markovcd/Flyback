<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <!-- Half of what a plugin is compiled against; see Directory.Build.props. -->
    <AssemblyVersion>$(PluginContractVersion)</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The engine walks the same op list the emitter builds, so the two share what
      an op is shaped like without that becoming something a plugin can name.
    -->
    <InternalsVisibleTo Include="Flyback.Engine" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Graph\NodeCatalog.Chords.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Color.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Feedback.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Maths.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Oscillators.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Output.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Patterns.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Sequencers.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Sources.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Space.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Envelopes.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Midi.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Strings.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\Presets.WholeBand.cs">
      <DependentUpon>Presets.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Buses.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
    <Compile Update="Graph\NodeCatalog.Duck.cs">
      <DependentUpon>NodeCatalog.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!--
      Holds the public surface to PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt
      beside this file, which is what a plugin is compiled against written down.
      It runs in the compiler and is gone from what is built: nothing here
      references it, and nothing is shipped because of it. That is the reading of
      ADR-0019 that lets Core have it.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
