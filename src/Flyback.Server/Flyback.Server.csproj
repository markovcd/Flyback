<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Flyback.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flyback.Engine\Flyback.Engine.csproj" />
    <ProjectReference Include="..\Flyback.Plugins\Flyback.Plugins.csproj" />
  </ItemGroup>

  <!--
    The web viewer (ADR-0160), served at /viewer/: from its own project folders when
    run from the source, and copied under wwwroot/viewer by a publish. Ahead-of-time
    compiled only where the publish passes -p:RunAOTCompilation=true, as the image does.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Flyback.Web\Flyback.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The web editor (ADR-0162), published under editor\ beside the site and served at
    /editor/, only where asked for with -p:WebEditor=true: it links Skia into the
    runtime, which needs the wasm-tools workload the gate's image does not have.
  -->
  <Target Name="PublishWebEditor" AfterTargets="Build" Condition="'$(WebEditor)' == 'true'">
    <MSBuild Projects="..\Flyback.WebEditor\Flyback.WebEditor.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(OutDir)editor'))\" />
  </Target>

  <Target Name="PublishWebEditorBeside" AfterTargets="Publish" Condition="'$(WebEditor)' == 'true'">
    <MSBuild Projects="..\Flyback.WebEditor\Flyback.WebEditor.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)editor'))\" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The presets the site starts with (ADR-0138), and the plugin package its image build adds (ADR-0141). -->
  <ItemGroup>
    <Content Include="Defaults\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The plugins the site starts with. A run from the source lays each out beside
    the site, under plugins\<FolderName>\, and the site packs it at every start.
    Not published: the image and release.sh pack each into <FolderName>.fbkp.
  -->
  <ItemGroup>
    <PluginProject Include="..\Flyback.Plugins.Figures\Flyback.Plugins.Figures.csproj" FolderName="Figures" Publish="false" />
    <PluginProject Include="..\Flyback.Plugins.Fractals\Flyback.Plugins.Fractals.csproj" FolderName="Fractals" Publish="false" />
    <PluginProject Include="..\Flyback.Plugins.Easy\Flyback.Plugins.Easy.csproj" FolderName="Easy" Publish="false" />
  </ItemGroup>

  <!-- Writes each as "project|FolderName", a line apiece, for the builds that pack them. -->
  <Target Name="ListSitePlugins">
    <WriteLinesToFile File="$(SitePluginsFile)" Lines="@(PluginProject->'%(FullPath)|%(FolderName)')" Overwrite="true" />
  </Target>

  <!--
    The whole Pages site, served beside the pages that need the server. The files
    that name the github.io address stay behind, and so does the Pages presets
    page, which the server's own shelf replaces.
  -->
  <ItemGroup>
    <Content Include="..\..\site\**"
             Exclude="..\..\site\sitemap.xml;..\..\site\google*.html;..\..\site\presets.html"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
