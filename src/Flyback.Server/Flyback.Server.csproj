<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Flyback.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flyback.Engine\Flyback.Engine.csproj" />
    <ProjectReference Include="..\Flyback.Plugins\Flyback.Plugins.csproj" />
  </ItemGroup>

  <!--
    The web viewer (ADR-0160), served at /viewer/: from its own project folders when
    run from the source, and copied under wwwroot/viewer by a publish. Ahead-of-time
    compiled only where the publish passes -p:RunAOTCompilation=true, as the image does.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Flyback.Viewer.Web\Flyback.Viewer.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The plugins the web viewer and editor link, named to BrowserPlugins, which checks a
    shared preset against them. Every one a page may link is referenced whatever the
    configuration, so the locked restore is the same in each.
  -->
  <Import Project="..\Flyback.Viewer.Web\LinkedPlugins.props" />

  <ItemGroup>
    <ProjectReference Include="..\plugins\Flyback.Plugins.Effects\Flyback.Plugins.Effects.csproj" />
    <ProjectReference Include="..\plugins\Flyback.Plugins.Mastering\Flyback.Plugins.Mastering.csproj" />
    <ProjectReference Include="..\plugins\Flyback.Plugins.Picture\Flyback.Plugins.Picture.csproj" />
    <ProjectReference Include="..\plugins\Flyback.Plugins.Voice\Flyback.Plugins.Voice.csproj" />
    <ProjectReference Include="..\plugins\Flyback.Plugins.Easy\Flyback.Plugins.Easy.csproj" />
    <ProjectReference Include="..\plugins\Flyback.Plugins.Figures\Flyback.Plugins.Figures.csproj" />
    <ProjectReference Include="..\plugins\Flyback.Plugins.Fractals\Flyback.Plugins.Fractals.csproj" />
  </ItemGroup>

  <Target Name="NameWebPlugins" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="WebPlugin" Value="%(WebPlugin.Filename)" />
    </ItemGroup>
  </Target>

  <!--
    The web editor (ADR-0162), published under editor\ beside the site and served at
    /editor/. It links Skia into the runtime, which needs the wasm-tools workload;
    -p:EditorWeb=false builds the site without it where that is missing.
  -->
  <PropertyGroup>
    <EditorWeb Condition="'$(EditorWeb)' == ''">true</EditorWeb>
  </PropertyGroup>

  <!-- A restore of its own: a publish evaluated before the restore wrote its assets fails on a clean checkout. -->
  <Target Name="RestoreEditorWeb" Condition="'$(EditorWeb)' == 'true'">
    <MSBuild Projects="..\Flyback.Editor.Web\Flyback.Editor.Web.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration);EditorWebRestore=true" />
  </Target>

  <Target Name="PublishEditorWeb" AfterTargets="Build" DependsOnTargets="RestoreEditorWeb" Condition="'$(EditorWeb)' == 'true'">
    <!-- The solution's own build of it, waited for rather than raced: two builds at once share its obj. -->
    <MSBuild Projects="..\Flyback.Editor.Web\Flyback.Editor.Web.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="..\Flyback.Editor.Web\Flyback.Editor.Web.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(OutDir)editor'))\" />
  </Target>

  <Target Name="PublishEditorWebBeside" AfterTargets="Publish" DependsOnTargets="RestoreEditorWeb" Condition="'$(EditorWeb)' == 'true'">
    <MSBuild Projects="..\Flyback.Editor.Web\Flyback.Editor.Web.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)editor'))\" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!-- The readers a submission is checked with, which flyback-site runs for the Worker. -->
  <ItemGroup>
    <Compile Include="..\Flyback.Site\Reading\*.cs" LinkBase="Reading" />
    <Using Include="Flyback.Site" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The presets the site starts with (ADR-0138), and the plugin package its image build adds (ADR-0141). -->
  <ItemGroup>
    <Content Include="Defaults\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The plugins the site starts with. A run from the source lays each out beside
    the site, under plugins\<FolderName>\, and the site packs it at every start.
    Not published: the image and release.sh pack each into <FolderName>.fbkp.
  -->
  <ItemGroup>
    <PluginProject Include="..\plugins\Flyback.Plugins.Figures\Flyback.Plugins.Figures.csproj" FolderName="Figures" Publish="false" />
    <PluginProject Include="..\plugins\Flyback.Plugins.Fractals\Flyback.Plugins.Fractals.csproj" FolderName="Fractals" Publish="false" />
    <PluginProject Include="..\plugins\Flyback.Plugins.Easy\Flyback.Plugins.Easy.csproj" FolderName="Easy" Publish="false" />
  </ItemGroup>

  <!-- Writes each as "project|FolderName", a line apiece, for the builds that pack them. -->
  <Target Name="ListSitePlugins">
    <WriteLinesToFile File="$(SitePluginsFile)" Lines="@(PluginProject->'%(FullPath)|%(FolderName)')" Overwrite="true" />
  </Target>

  <!--
    The whole Pages site, served beside the pages that need the server. The files
    that name the github.io address stay behind.
  -->
  <ItemGroup>
    <Content Include="..\..\site\**"
             Exclude="..\..\site\sitemap.xml;..\..\site\google*.html"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
