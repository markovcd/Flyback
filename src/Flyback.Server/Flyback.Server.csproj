<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Flyback.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flyback.Engine\Flyback.Engine.csproj" />
    <ProjectReference Include="..\Flyback.Plugins\Flyback.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The presets the site starts with (ADR-0138). -->
  <ItemGroup>
    <Content Include="Defaults\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Pages site's own stylesheet, script and logo, so the two sites cannot drift apart. -->
  <ItemGroup>
    <Content Include="..\..\site\assets\site.css;..\..\site\assets\site.js;..\..\site\assets\logo.svg;..\..\site\assets\share.jpg;..\..\site\assets\donate-qr.svg"
             Link="wwwroot\assets\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
