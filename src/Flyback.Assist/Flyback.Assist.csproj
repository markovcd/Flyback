<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything about the assistant: the workbench it edits a patch through, the turn,
    the assistants and decision models Flyback has, where their keys are kept, the session the editor's
    column and flyback-cli ask both drive, and how a conversation is saved with its
    patch. None of it is plugin contract (ADR-0231, ADR-0232, ADR-0233).
  -->
  <PropertyGroup>
    <RootNamespace>Flyback.Assist</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flyback.Core\Flyback.Core.csproj" />
    <ProjectReference Include="..\Flyback.Engine\Flyback.Engine.csproj" />
    <ProjectReference Include="..\Flyback.Plugins\Flyback.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flyback" />
    <InternalsVisibleTo Include="Flyback.Editor" />
    <InternalsVisibleTo Include="Flyback.Editor.Web" />
    <InternalsVisibleTo Include="Flyback.Editor.Android" />
    <InternalsVisibleTo Include="flyback-cli" />
    <InternalsVisibleTo Include="Flyback.Editor.Tests" />
    <InternalsVisibleTo Include="Flyback.Ui.Tests" />
    <InternalsVisibleTo Include="Flyback.Viewer.Desktop.Tests" />
    <InternalsVisibleTo Include="Flyback.Editor.Desktop.Tests" />
    <InternalsVisibleTo Include="Flyback.Cli.Tests" />
    <InternalsVisibleTo Include="Flyback.Specs" />
    <InternalsVisibleTo Include="Flyback.Assist.Tests" />
    <InternalsVisibleTo Include="Flyback.Plugins.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows secret store; it compiles anywhere and answers only on Windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="priority-modules.txt" LogicalName="priority-modules.txt" />
  </ItemGroup>

</Project>
