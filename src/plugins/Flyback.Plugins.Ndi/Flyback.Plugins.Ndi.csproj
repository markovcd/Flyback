<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Flyback.Plugins.Ndi</RootNamespace>
    <!-- Emits the .deps.json that marks the entry assembly among the files in the plugin folder. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- What the install dialog and the plugins window show. -->
    <Product>NDI</Product>
    <Authors>Flyback</Authors>
    <Description>Sends the picture over the network to VJ software such as Resolume, through the NDI runtime installed on the machine. Flyback carries none of NDI's own files.</Description>

    <!-- The runtime is called through function pointers looked up in the library it found. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Tags" Value="picture" />
    <InternalsVisibleTo Include="Flyback.Plugins.Ndi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both are host-owned; shipping either would give its types a second identity. -->
    <ProjectReference Include="../../Flyback.Plugins/Flyback.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />

    <ProjectReference Include="../../Flyback.Core/Flyback.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
  </ItemGroup>

</Project>
