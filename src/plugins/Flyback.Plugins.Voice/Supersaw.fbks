# A patch to start from: seven saws at 110 Hz, the detune swept. At no detune it
# is one saw. Both outputs go to their own channel, so the width is real. Nothing
# is drawn: seven voices beating against each other is a thing for the ear.

description "Seven detuned saws, wired the way the module is meant to be driven."
tags "synthesis" "melody"

requires flyback.voice

# The detune goes 0..1 over about sixteen seconds.
let saws = osc(freq: 110, detune: sine(freq: 0.06, amp: 0.5, bias: 0.5), mix: 0.9)

saws |> out.left
saws.wide |> out.right
