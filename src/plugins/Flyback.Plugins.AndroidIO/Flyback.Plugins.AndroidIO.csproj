<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sound on Android, linked into Flyback.Editor.Android rather than loaded from a folder
    (ADR-0184). Needs the android workload, so Flyback.slnx lists it without building it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>Flyback.Plugins.AndroidIO</RootNamespace>

    <!-- What the plugins window shows. -->
    <Product>Android sound</Product>
    <Authors>Flyback</Authors>
    <Description>Sound out through AudioTrack and in through AudioRecord.</Description>

    <!-- As the Android editor: the packages the workload adds are versioned with it. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Tags" Value="sound; android" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both are host-owned; shipping either would give its types a second identity. -->
    <ProjectReference Include="../../Flyback.Plugins/Flyback.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
    <ProjectReference Include="../../Flyback.Core/Flyback.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
  </ItemGroup>

  <ItemGroup>
    <!-- The thread every blocking device writes or reads on, compiled into each plugin that has one. -->
    <Compile Include="..\Shared\Audio\*.cs" LinkBase="Audio" />
  </ItemGroup>

</Project>
