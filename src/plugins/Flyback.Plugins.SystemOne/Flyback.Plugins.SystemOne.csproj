<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Flyback.Plugins.SystemOne</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- What the install dialog and the plugins window show. -->
    <Product>Decision server</Product>
    <Authors>Flyback</Authors>
    <Description>Answers the editor's questions through an endpoint that speaks the System One format: TypeSafe's hosted model, or a laya-serve.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Tags" Value="decision model; ai" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both are host-owned; shipping either would give its types a second identity. -->
    <ProjectReference Include="../../Flyback.Plugins/Flyback.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
    <ProjectReference Include="../../Flyback.Core/Flyback.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime"
                      GlobalPropertiesToRemove="OutDir" />
  </ItemGroup>

  <!-- No package: the format is one POST of a dozen fields, written out in Flyback.Plugins' SystemOneWire. -->

  <ItemGroup>
    <InternalsVisibleTo Include="Flyback.Plugins.SystemOne.Tests" />
  </ItemGroup>

</Project>
