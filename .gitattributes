# Normalize line endings on commit, check out native on each platform.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.slnx    text
*.json    text
*.md      text
*.fbk     text
*.fbks    text
*.sh      text eol=lf

# Docker reads both line by line and does not strip a carriage return, so a
# CRLF checkout leaves every .dockerignore pattern ending in one and matching
# nothing: the whole of bin/ and obj/ is then sent as build context and copied
# into the image. Held to LF so a build on Windows has the context CI has.
.dockerignore   text eol=lf
Dockerfile      text eol=lf
*/Dockerfile    text eol=lf

*.png  binary
*.ico  binary
*.icns binary
*.webp binary
*.mp4  binary
*.mp3  binary

# A bundle is a zip archive, so it must not be normalized on the way in.
*.fbkb binary

# Verify snapshots: the comparer rejects any \r in a *.verified.* baseline, so
# these must stay LF in the working tree even on Windows.
*.verified.*     text eol=lf working-tree-encoding=UTF-8
*.verified.png   binary
