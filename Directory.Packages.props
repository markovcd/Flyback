<Project>

  <!--
    Every package version in the solution, named once. A project says which
    packages it takes and this file says which version of each, so the sixteen
    project files cannot disagree about one — eight of them want the same test
    runner, and nothing but care would hold eight copies of a version in step.

    A version here is exact and never a range, and restore writes a
    packages.lock.json beside each project from it (see Directory.Build.props),
    so the transitive graph is pinned as well as the direct one.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      A version left on a PackageReference is a version this file does not
      govern, which is the one failure mode central management has.
    -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <!-- The shell: Avalonia, and the two controls it does not come with. -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />

    <!--
      Both are built for Avalonia 12 and versioned by their own authors rather
      than with the framework, so neither moves when Avalonia does.
    -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />

    <!-- The editor's container and its HTTP clients (ADR-0150): the runtime's own, versioned with it. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <!-- The command line, the preset site, and the two platform plugins that need something. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <!-- Runs in the compiler and ships in nothing, which is what ADR-0019 allows Core. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- Tests. None of it is referenced by anything under src/. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.4.1" />
    <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Verify.ImageMagick" Version="3.10.0" />
    <PackageVersion Include="Verify.XunitV3" Version="33.1.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
