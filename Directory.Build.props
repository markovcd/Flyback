<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Whether a release passed the real version with -p:Version=X.Y.Z (see
      Dockerfile and the release workflow) before the default below fills the
      gap. A command-line property is global and reaches every PropertyGroup
      from the start of evaluation, so this reads true exactly when one was
      given — it is not testing the assignment below, which runs regardless.
    -->
    <_VersionSpecified Condition="'$(Version)' != ''">true</_VersionSpecified>

    <!--
      The version a plain build reports. Every version-bearing assembly
      attribute (AssemblyVersion, AssemblyFileVersion,
      AssemblyInformationalVersion) is derived from this single property,
      which is what About.cs reads back.
    -->
    <Version Condition="'$(Version)' == ''">0.1.0</Version>

    <!--
      A release build's version already names a real release and stands on
      its own. A dev build's does not — every plain build is "0.1.0" until
      the next release, so the commit it was built from is what actually
      tells two of them apart. ShortenSourceRevisionId below trims that
      commit to seven characters before GenerateAssemblyInfo appends it.
    -->
    <IncludeSourceRevisionInInformationalVersion Condition="'$(_VersionSpecified)' != 'true'">true</IncludeSourceRevisionInInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(_VersionSpecified)' == 'true'">false</IncludeSourceRevisionInInformationalVersion>

    <!--
      The version of what a plugin is compiled against: the public surface of
      Flyback.Core and Flyback.Plugins, and nothing else. Those two take it as
      their AssemblyVersion in place of the release's, because it is what the
      compiler stamps into a plugin and what the host reads back before loading
      one, and a release that changed nothing a plugin can see should not look
      like one that did.

        major   something a plugin could have used was removed or changed; every
                plugin built against the last one is refused until it is rebuilt
        minor   something was added; a plugin built against the new one is
                refused by a host that only has the old
        patch   never moves, since a fix that changes no signature changes
                nothing a plugin was compiled against

      PublicAPI.Shipped.txt beside each of the two projects is that surface as
      the last release offered it, and PublicAPI.Unshipped.txt is what has
      changed since. Neither project builds until a change to its surface is
      written into the second file (the error names the line), so the question
      of which number moves is asked in the commit that moves it: the minor
      with the first line added since a release, the major with the first line
      marked *REMOVED*. A release moves what is unshipped into what is shipped.
    -->
    <PluginContractVersion>1.2.0</PluginContractVersion>
  </PropertyGroup>

  <!--
    $(SourceRevisionId) is the full 40-character commit hash the SDK reads
    from .git; AddSourceRevisionToInformationalVersion appends it verbatim.
    Hooked between the target that sets it and the one that appends it, so a
    dev build's version reads "0.1.0+37fc87f" rather than the full hash.
  -->
  <Target Name="ShortenSourceRevisionId"
          AfterTargets="InitializeSourceControlInformation"
          BeforeTargets="AddSourceRevisionToInformationalVersion"
          Condition="'$(SourceRevisionId)' != '' and $(SourceRevisionId.Length) &gt;= 7">
    <PropertyGroup>
      <SourceRevisionId>$(SourceRevisionId.Substring(0, 7))</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
